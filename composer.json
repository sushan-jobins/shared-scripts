{
    "name": "sushan-jobins/shared-scripts",
    "description": "Shared development scripts for Laravel projects",
    "type": "composer-plugin",
    "require": {
        "php": "^8.1",
        "composer-plugin-api": "^2.0",
        "symfony/console": "^6.0|^7.0"
    },
    "autoload": {
        "psr-4": {
            "SushanJobins\\SharedScripts\\": "src/"
        }
    },
    "extra": {
        "class": "SushanJobins\\SharedScripts\\SharedScriptsPlugin"
    }
}